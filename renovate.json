{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customDatasources": {
    "minecraft": {
      "defaultRegistryUrlTemplate": "https://api.modrinth.com/v2/tag/game_version",
      "transformTemplates": [
        "{ \"releases\": $[version_type = 'release'].{ \"version\": version, \"releaseTimestamp\": date } }"
      ]
    }
  },
  "customManagers": [
    {
      "description": "appends new Minecraft releases to the game versions published to Modrinth",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/build\\.yml$/"
      ],
      "matchStrings": [
        "\\n(?<indentation>[ ]+)(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)\\s*$"
      ],
      "depNameTemplate": "minecraft",
      "datasourceTemplate": "custom.minecraft",
      "versioningTemplate": "loose",
      "autoReplaceStringTemplate": "\n{{{indentation}}}{{{currentValue}}}\n{{{indentation}}}{{{newValue}}}"
    }
  ],
  "packageRules": [
    {
      "description": "not a dependency to keep current",
      "matchPackageNames": [
        "io.papermc.paper:paper-api"
      ],
      "enabled": false
    },
    {
      "description": "a new Minecraft version is only claimed once it has been tested",
      "matchDatasources": [
        "custom.minecraft"
      ],
      "commitMessageTopic": "supported Minecraft versions",
      "commitMessageExtra": "(add {{{newValue}}})",
      "automerge": false
    }
  ]
}
